# Copy to .env and fill in. .env is git-ignored: never commit it.
#
# fleet-sim always sends to the internal collector; the collector forwards
# everything to the external OTLP/HTTP backend configured here.

# --- Dash0 -------------------------------------------------------------------
# Endpoint and auth token: Dash0 > Settings > Endpoints / Auth Tokens
# UPSTREAM_OTLP_ENDPOINT=https://ingress.eu-west-1.aws.dash0.com
# UPSTREAM_OTLP_AUTH_HEADER=Bearer auth_xxxxxxxxxxxxxxxx
# DASH0_DATASET=default

# --- Grafana Cloud -----------------------------------------------------------
# Endpoint, instance ID and token: Grafana Cloud > your stack > OpenTelemetry
# Build the header value with:  printf '%s' '<instance-id>:<token>' | base64 -w0
# UPSTREAM_OTLP_ENDPOINT=https://otlp-gateway-prod-eu-west-2.grafana.net/otlp
# UPSTREAM_OTLP_AUTH_HEADER=Basic <base64 output>

# --- Simulator ---------------------------------------------------------------
OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=demo
# FLEET_ROBOTS=6
# FLEET_INTERVAL_MIN=1.0
# FLEET_INTERVAL_MAX=3.0
# FLEET_FAULT_SCALE=1.0
# FLEET_SEED=42
